<%- include('../partials/header') %>
<h2>Assignments</h2>
<a href="/assignments/add" class="btn btn-primary mb-3">+ Add</a>
<table class="table">
  <tr><th>Title</th><th>Course</th><th>Due</th><th></th></tr>
  <% assignments.forEach(a => { %>
  <tr>
    <td><%= a.title %></td>
    <td><%= a.course %></td>
    <td><%= a.dueDate.toDateString() %></td>
    <td>
      <a href="/assignments/edit/<%= a._id %>" class="btn btn-sm btn-warning">Edit</a>
      <a href="/assignments/delete/<%= a._id %>" class="btn btn-sm btn-danger">Delete</a>
    </td>
  </tr>
  <% }) %>
</table>
<%- include('../partials/footer') %>
