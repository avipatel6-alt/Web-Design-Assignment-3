<%- include('../partials/header') %>
<h2><%= assignment._id ? 'Edit' : 'Add' %> Assignment</h2>
<form method="POST" action="<%= action %>">
  <input class="form-control mb-2" name="title" placeholder="Title" value="<%= assignment.title || '' %>" required>
  <input class="form-control mb-2" name="course" placeholder="Course" value="<%= assignment.course || '' %>" required>
  <input class="form-control mb-2" type="date" name="dueDate" value="<%= assignment.dueDate ? assignment.dueDate.toISOString().split('T')[0] : '' %>" required>
  <button class="btn btn-success">Save</button>
  <a href="/assignments" class="btn btn-secondary">Cancel</a>
</form>
<%- include('../partials/footer') %>
 